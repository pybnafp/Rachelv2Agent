[Unit]
Description=Rachel v2 API (uvicorn, 127.0.0.1:8000)
After=network.target redis-server.service postgresql.service
Requires=network.target
Wants=redis-server.service postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Rachelv2Agent
EnvironmentFile=/root/Rachelv2Agent/.env
ExecStart=/root/miniconda3/envs/rachel-v2/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --app-dir /root/Rachelv2Agent/backend
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
